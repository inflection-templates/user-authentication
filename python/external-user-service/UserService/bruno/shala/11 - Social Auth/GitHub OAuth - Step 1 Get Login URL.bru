meta {
  name: GitHub OAuth - Step 1 Get Login URL
  type: http
  seq: 14
}

get {
  url: {{BASE_URL}}/api/v1/users/oauth/github/login
  body: none
  auth: none
}

headers {
  Content-Type: application/json
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response has authorization URL", function() {
    expect(res.getBody()).to.have.property('data');
    expect(res.getBody().data).to.have.property('authorization_url');
    expect(res.getBody().data.authorization_url).to.be.a('string');
  });
  
  test("Authorization URL contains GitHub", function() {
    expect(res.getBody().data.authorization_url).to.include('github.com');
  });
  
  test("Log the authorization URL for manual testing", function() {
    const authUrl = res.getBody().data.authorization_url;
    console.log("🔗 GitHub Authorization URL (C# Style):");
    console.log(authUrl);
    console.log("📝 Copy this URL and open it in your browser");
    console.log("🔄 After GitHub login, you'll be redirected to http://localhost:5000");
  });
}
