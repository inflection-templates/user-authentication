meta {
  name: 11 - Test New Backup Code
  type: http
  seq: 11
}

post {
  url: {{BASE_URL}}/api/v1/users/mfa/validate
  body: json
  auth: none
}

headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

body:json {
  {
    "token": "{{FIRST_BACKUP_CODE}}",
    "method": "backup"
  }
}

script:post-response {
  let status = res.getStatus();
  console.log("=== STEP 11: TEST NEW BACKUP CODE ===");
  console.log("New Backup Code Validation Status:", status);
  
  if (status == 200) {
    console.log("✅ New Backup Code Validation Successful!");
    console.log("Response:", res.body);
    console.log("Method used:", res.body.method);
    console.log("Message:", res.body.message);
    console.log("⚠️ Note: This backup code is now invalidated");
    console.log("Next: Step 12 - Disable MFA (optional)");
  } else {
    console.error("❌ New Backup Code Validation Failed:", res.body);
    console.log("Make sure you're using a valid new backup code from Step 10");
  }
}
