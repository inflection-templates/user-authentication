{
  "name": "order-service",
  "version": "1.0.0",
  "description": "Node.js Order Management Service with JWT authentication and JWKS caching",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsc && ts-node --files ./src/index.ts",
    "dev": "nodemon --exec ts-node --files ./src/index.ts",
    "lint": "eslint ./src/**",
    "lint:fix": "eslint ./src/** --fix",
    "test": "tsc && mocha -u tdd --timeout 999999 --colors ./dist/tests/**/*.js",
    "test-debug": "NODE_ENV=test mocha --file ./tests/init.ts --reporter spec --exit"
  },
  "keywords": [
    "order-service",
    "jwt",
    "authentication",
    "express",
    "mysql",
    "redis",
    "typescript"
  ],
  "author": "Order Service Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "helmet": "^5.1.1",
    "dotenv": "^8.6.0",
    "mysql2": "^3.9.7",
    "sequelize": "^6.30.0",
    "sequelize-typescript": "^2.1.6",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.0.1",
    "node-cache": "^5.1.2",
    "redis": "^4.6.12",
    "axios": "^1.9.0",
    "joi": "^17.13.3",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^6.15.0",
    "reflect-metadata": "^0.1.13",
    "tsyringe": "^4.8.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/cors": "^2.8.13",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^18.17.15",
    "@types/uuid": "^9.0.2",
    "@types/redis": "^4.0.11",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6",
    "eslint": "8.45.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.27.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
