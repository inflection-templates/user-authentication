# Order Service Configuration

# Server Configuration
NODE_ENV=development
PORT=5001
HOST=0.0.0.0
LOG_LEVEL=info

# Database Configuration
DB_DIALECT=mysql
DB_USER_NAME=root
DB_USER_PASSWORD=root
DB_NAME=auth_order_node
DB_HOST=localhost
DB_PORT=3306

# JWT Authentication Configuration
JWT_AUTHORITY=http://localhost:7373
JWT_AUDIENCE=shala
JWT_JWKS_URL=http://localhost:7373/.well-known/jwks.json

# JWKS Caching Configuration
JWKS_CACHE_TYPE=in_memory
REDIS_URL=redis://localhost:6379
JWKS_REFRESH_INTERVAL_MINUTES=5
JWKS_ENABLE_BACKGROUND_REFRESH=true

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
