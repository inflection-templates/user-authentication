meta {
  name: Create Customer - Alternative
  type: http
  seq: 7
}

post {
  url: {{base_url}}/api/customers
  body: json
}

headers {
  Authorization: Bearer {{jwt_token}}
  Content-Type: application/json
}

vars:pre-request {
  randomEmail: {{$randomEmail}}
  randomName: {{$randomFirstName}}
}

body:json {
  {
    "firstName": "{{randomName}}",
    "lastName": "TestUser",
    "email": "{{randomEmail}}",
    "phone": "+1234567890",
    "address": "123 Test St, Test City, TC 12345"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
}

tests {
  test("Create customer with random data returns success", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().success).to.equal(true);
    expect(res.getBody().customer).to.be.an('object');
    expect(res.getBody().customer.id).to.exist;
    expect(res.getBody().customer.email).to.contain("@");
  });
  
  test("Store customer ID for future requests", function() {
    if (res.getStatus() === 201) {
      bru.setVar("customer_id", res.getBody().customer.id);
    }
  });
}
