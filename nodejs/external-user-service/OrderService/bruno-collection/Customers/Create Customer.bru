meta {
  name: Create Customer
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/customers
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{jwt_token}}
  Content-Type: application/json
}

body:json {
  {
    "firstName": "John",
    "lastName": "Doe",
    "email": "john.doe1@example.com",
    "phone": "+1234567890",
    "address": "123 Main St, Anytown, USA"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
}

tests {
  test("Create customer returns success", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().success).to.equal(true);
    expect(res.getBody().customer).to.be.an('object');
    expect(res.getBody().customer.id).to.exist;
    expect(res.getBody().customer.first_name).to.equal("John");
    expect(res.getBody().customer.last_name).to.equal("Doe");
    expect(res.getBody().customer.email).to.equal("john.doe@example.com");
  });
  
  test("Store customer ID for future requests", function() {
    if (res.getStatus() === 201) {
      bru.setVar("customer_id", res.getBody().customer.id);
    }
  });
}
