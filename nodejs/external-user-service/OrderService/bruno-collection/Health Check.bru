meta {
  name: Health Check
  type: http
  seq: 1
}

get {
  url: {{base_url}}/health
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

tests {
  test("Health check returns success", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.equal(true);
    expect(res.getBody().message).to.contain("healthy");
  });
}
