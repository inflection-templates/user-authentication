meta {
  name: Update Order
  type: http
  seq: 4
}

put {
  url: {{base_url}}/api/orders/:orderId
  body: json
}

params:path {
  orderId: {{order_id}}
}

headers {
  Authorization: Bearer {{jwt_token}}
  Content-Type: application/json
}

body:json {
  {
    "status": "Processing",
    "notes": "Order is being processed",
    "shipping_address": "456 Updated St, New City, NC 67890"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

tests {
  test("Update order returns success", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.equal(true);
    expect(res.getBody().order).to.be.an('object');
    expect(res.getBody().order.status).to.equal("Processing");
  });
}
