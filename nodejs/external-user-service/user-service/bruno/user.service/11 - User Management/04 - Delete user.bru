meta {
  name: Delete user
  type: http
  seq: 4
}

delete {
  url: {{BASE_URL}}/users/{{USER_ID_TO_DELETE}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{ADMIN_USER_JWT}}
  Content-Type: application/json
}

script:pre-request {
  // Use a test user ID for deletion - make sure this is a test user!
  // You should set USER_ID_TO_DELETE to a user that can be safely deleted
  var userIdToDelete = bru.getEnvVar("TEST_USER_ID") || bru.getEnvVar("USER_ID");
  bru.setEnvVar("USER_ID_TO_DELETE", userIdToDelete);
}

tests {
  test("Request is successful", function () {
    expect(res.getStatus()).to.equal(200);
    var jsonRes = res.getBody();
    expect(jsonRes.Status).to.eql('success');
  });

  test("User deletion is confirmed", function () {
    var jsonRes = res.getBody();
    expect(jsonRes.Message).to.include('deleted');
  });

  // Verify the user is actually deleted by trying to get it
  test("User is no longer accessible", function () {
    // This test would need to be followed by a GET request to verify deletion
    // For now, we just confirm the deletion response
    var jsonRes = res.getBody();
    expect(jsonRes.Status).to.eql('success');
  });
}

docs {
  Deletes a user by their ID. This is a permanent operation and cannot be undone.
  
  ⚠️ WARNING: This operation permanently deletes the user and all associated data.
  Only use this endpoint with test users or in non-production environments.
  
  Requirements:
  - Valid JWT token with admin privileges in Authorization header
  - User ID in the URL path
  
  The USER_ID_TO_DELETE environment variable should be set to the ID of the user to delete.
  This should typically be a test user created specifically for deletion testing.
  
  After deletion, the user will no longer be accessible via any user endpoints.
}
