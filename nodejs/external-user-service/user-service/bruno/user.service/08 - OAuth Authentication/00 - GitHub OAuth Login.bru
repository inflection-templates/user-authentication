meta {
  name: GitHub OAuth Login
  type: http
  seq: 0
}

get {
  url: {{host}}/api/v1/auth/oauth/github/login
  body: none
  auth: none
}

assert {
  res.status: 200
  res.body.Success: true
  res.body.Data.authUrl: isString
}

tests {
  test("Should return GitHub authorization URL", function() {
    expect(res.status).to.equal(200);
    expect(res.body.Success).to.be.true;
    expect(res.body.Data).to.have.property('authUrl');
    expect(res.body.Data.authUrl).to.include('github.com/login/oauth/authorize');
    expect(res.body.Data.authUrl).to.include('client_id=');
    expect(res.body.Data.authUrl).to.include('redirect_uri=');
    expect(res.body.Data.authUrl).to.include('scope=user:email');
    expect(res.body.Data.authUrl).to.include('state=');
  });
}
