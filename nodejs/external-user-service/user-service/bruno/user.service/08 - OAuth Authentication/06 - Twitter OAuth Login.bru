meta {
  name: Twitter OAuth Login
  type: http
  seq: 6
}

get {
  url: {{BASE_URL}}/auth/oauth/twitter/login
  body: none
  auth: none
}

assert {
  res.status: 200
  res.body.Success: true
  res.body.Data.authUrl: isString
}

tests {
  test("Should return Twitter authorization URL", function() {
    expect(res.status).to.equal(200);
    expect(res.body.Success).to.be.true;
    expect(res.body.Data).to.have.property('authUrl');
    expect(res.body.Data.authUrl).to.include('twitter.com/i/oauth2/authorize');
    expect(res.body.Data.authUrl).to.include('client_id=');
    expect(res.body.Data.authUrl).to.include('redirect_uri=');
    expect(res.body.Data.authUrl).to.include('scope=tweet.read%20users.read%20offline.access');
    expect(res.body.Data.authUrl).to.include('response_type=code');
    expect(res.body.Data.authUrl).to.include('state=');
    expect(res.body.Data.authUrl).to.include('code_challenge=challenge');
    expect(res.body.Data.authUrl).to.include('code_challenge_method=plain');
  });
}
