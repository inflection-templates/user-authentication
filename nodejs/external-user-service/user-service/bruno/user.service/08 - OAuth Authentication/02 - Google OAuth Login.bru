meta {
  name: Google OAuth Login
  type: http
  seq: 2
}

get {
  url: {{BASE_URL}}/auth/oauth/google/login
  body: none
  auth: none
}

assert {
  res.status: 200
  res.body.Success: true
  res.body.Data.authUrl: isString
}

tests {
  test("Should return Google authorization URL", function() {
    expect(res.status).to.equal(200);
    expect(res.body.Success).to.be.true;
    expect(res.body.Data).to.have.property('authUrl');
    expect(res.body.Data.authUrl).to.include('accounts.google.com/o/oauth2/auth');
    expect(res.body.Data.authUrl).to.include('client_id=');
    expect(res.body.Data.authUrl).to.include('redirect_uri=');
    expect(res.body.Data.authUrl).to.include('scope=openid%20email%20profile');
    expect(res.body.Data.authUrl).to.include('response_type=code');
    expect(res.body.Data.authUrl).to.include('state=');
  });
}
