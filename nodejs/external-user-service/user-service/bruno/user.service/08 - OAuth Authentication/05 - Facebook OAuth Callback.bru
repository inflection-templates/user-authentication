meta {
  name: Facebook OAuth Callback
  type: http
  seq: 5
}

get {
  url: {{BASE_URL}}/auth/oauth/facebook/callback?code={{facebook_code}}&state={{facebook_state}}
  body: none
  auth: none
}

params:query {
  code: {{facebook_code}}
  state: {{facebook_state}}
}

vars:pre-request {
  facebook_code: test_authorization_code_789
  facebook_state: random_state_value_facebook
}

assert {
  res.status: 200
  res.body.Success: true
}

tests {
  test("Should authenticate user with Facebook OAuth", function() {
    expect(res.status).to.equal(200);
    expect(res.body.Success).to.be.true;
    expect(res.body.Data).to.have.property('AccessToken');
    expect(res.body.Data).to.have.property('User');
    expect(res.body.Data).to.have.property('SessionId');
  });
}
