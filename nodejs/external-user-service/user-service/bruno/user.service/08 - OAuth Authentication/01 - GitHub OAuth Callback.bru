meta {
  name: GitHub OAuth Callback
  type: http
  seq: 1
}

get {
  url: {{BASE_URL}}/auth/oauth/github/callback?code={{github_code}}&state={{github_state}}
  body: none
  auth: none
}

params:query {
  code: {{github_code}}
  state: {{github_state}}
}

vars:pre-request {
  github_code: test_authorization_code_123
  github_state: random_state_value
}

assert {
  res.status: 200
  res.body.Success: true
}

tests {
  test("Should authenticate user with GitHub OAuth", function() {
    expect(res.status).to.equal(200);
    expect(res.body.Success).to.be.true;
    expect(res.body.Data).to.have.property('AccessToken');
    expect(res.body.Data).to.have.property('User');
    expect(res.body.Data).to.have.property('SessionId');
  });
}
