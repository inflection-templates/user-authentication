meta {
  name: 06 - Create user - duplicate phone and password
  type: http
  seq: 6
}

post {
  url: {{BASE_URL}}/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-api-key: {{API_CLIENT_INTERNAL_KEY}}
}

body:json {
  {
    "PhoneCode": "{{PHONE_COUNTRY_CODE}}",
    "PhoneNumber": "{{PHONE_NUMBER}}",
    "TenantId":"{{TENANT_ID}}",
    "Password": "Test@123"
  }
}

tests {
  try {
      var jsonRes = res.getBody();
      bru.setEnvVar("USER_ID", jsonRes.Data.User.id);
  }
  catch (error) {
      console.log(error.message);
  }
}

docs {
  Registers patient. Phone number is the only mandatory field. The rest of the fields are optional. Phone number has to be specified in this format - 'country-code-phone-number'. e.g. "+91-1234567890".

  The typical request body is as follows -
  `
  {
      "Phone": "+91-1234567890",
      "Prefix": "Mr.",
      "FirstName": "John",
      "MiddleName": "X",
      "LastName": "Doe",
      "Email": "john.doe@gmail.com",
      "Gender": "Male",
      "BirthDate": "1979-01-01",
      "ImageResourceId": "20fd7e52-0d24-4599-bda5-3ed7be2dd383"
  }
  `
}
