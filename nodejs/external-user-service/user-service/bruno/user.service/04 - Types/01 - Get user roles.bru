meta {
  name: 01 - Get user roles
  type: http
  seq: 2
}

get {
  url: {{BASE_URL}}/roles/search
  body: none
  auth: none
}

headers {
  x-api-key: {{API_CLIENT_INTERNAL_KEY}}
  Content-Type: application/json
}

script:post-response {
  try {
      var jsonRes = res.getBody();
      var roles = jsonRes.Data.Roles.Items;
      for(var i = 0; i < roles.length; i++) {
          var r = roles[i];
          var name = r.Name;
          var id = r.id;
          const name_ = name.toUpperCase();
          roleName = name_.replace(" ", "_");
          var str = "ROLE_" + roleName + "_ID";
          console.log(str);
          console.log(id);
          bru.setEnvVar(str, id);
      }
  }
  catch (error) {
      console.log(error.message);
  }
  
}
