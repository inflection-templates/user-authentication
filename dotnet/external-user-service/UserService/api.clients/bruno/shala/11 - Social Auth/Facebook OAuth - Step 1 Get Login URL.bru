meta {
  name: Facebook OAuth - Step 1 Get Login URL
  type: http
  seq: 18
}

get {
  url: {{BASE_URL}}/api/v1/oauth/facebook/challenge
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response has correct structure", function() {
    expect(res.getBody()).to.have.property('success');
    expect(res.getBody()).to.have.property('message');
    expect(res.getBody()).to.have.property('data');
    expect(res.getBody().success).to.be.true;
    expect(res.getBody().message).to.equal("Facebook login link generated successfully!");
  });
  
  test("Response has URL property", function() {
    expect(res.getBody().data).to.have.property('Url');
    expect(res.getBody().data.Url).to.be.a('string');
  });
  
  test("URL contains Facebook", function() {
    expect(res.getBody().data.Url).to.include('facebook.com');
  });
  
  test("URL contains required OAuth parameters", function() {
    const authUrl = res.getBody().data.Url;
    expect(authUrl).to.include('client_id=');
    expect(authUrl).to.include('redirect_uri=');
    expect(authUrl).to.include('scope=');
    expect(authUrl).to.include('state=');
    expect(authUrl).to.include('response_type=code');
  });
  
  test("Log the authorization URL for manual testing", function() {
    const authUrl = res.getBody().data.Url;
    console.log("🔗 Facebook Authorization URL:");
    console.log(authUrl);
    console.log("📝 Copy this URL and open it in your browser");
    console.log("🔄 After Facebook login, you'll be redirected to your configured redirect URI");
    console.log("📋 The redirect will contain a 'code' parameter that you can use for Step 2");
    console.log("⚠️  Make sure your Facebook App has the correct redirect URI configured:");
    console.log("   http://localhost:5000/api/v1/oauth/facebook/callback");
  });
}
